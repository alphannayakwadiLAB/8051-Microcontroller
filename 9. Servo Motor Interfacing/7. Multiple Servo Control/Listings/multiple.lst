   7          // Timer 0 delay for 11.0592 MHz
   8          void delay_us(unsigned int us)
   9          {
  10   1          unsigned long count;
  11   1          unsigned int reload;
  12   1      
  13   1          count = ((unsigned long)us * 9216UL) / 10000UL;
  14   1      
  15   1          reload = 65536UL - count;
  16   1      
  17   1          TH0 = reload >> 8;
  18   1          TL0 = reload;
  19   1      
  20   1          TF0 = 0;
  21   1          TR0 = 1;
  22   1      
  23   1          while(TF0 == 0);
  24   1      
  25   1          TR0 = 0;
  26   1          TF0 = 0;
  27   1      }
  28          
  29          // Control two servos
  30          void servo_control(unsigned int pulse1,
  31                             unsigned int pulse2)
  32          {
  33   1          // Both servos ON
  34   1          SERVO1 = 1;
  35   1          SERVO2 = 1;
  36   1      
  37   1          // Servo 1 pulse
  38   1          delay_us(pulse1);
  39   1          SERVO1 = 0;
  40   1      
  41   1          // Servo 2 pulse remaining
  42   1          if(pulse2 > pulse1)
  43   1              delay_us(pulse2 - pulse1);
  44   1      
  45   1          SERVO2 = 0;
  46   1      
  47   1          // Complete 20ms frame
  48   1          if(pulse1 > pulse2)
  49   1              delay_us(pulse1 - pulse2);
  50   1      
  51   1          delay_us(20000 - (pulse1 > pulse2 ?
  52   1                            pulse1 : pulse2));
  53   1      }
